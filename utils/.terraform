alias tf='terraform'
alias tfi='terraform init -upgrade'
alias tfp='terraform plan -out=plan.out | tee plan.txt'

mkdir -p $HOME/.terraform.d/plugin-cache

tf-workspace() {
  tf workspace select $(tf workspace list | fzf)
}

tfi-all() { 
  for d in */*/; do (cd "$d" && terraform init -upgrade); done
}

# Run tfswitch automatically if 'main.tf' file is present
load-tfswitch() {
  local terraform_versionfile_path="main.tf"
  if [ -f "$terraform_versionfile_path" ]; then
    tfswitch
  fi
}
add-zsh-hook chpwd load-tfswitch
load-tfswitch
                